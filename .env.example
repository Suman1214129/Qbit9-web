# Which data layer the app uses. "mock" runs fully in the browser with simulated queue data.
# Later: "supabase" once src/services/supabase is implemented.
NEXT_PUBLIC_QBIT9_ADAPTER=mock

# Public origin, used for QR links and share URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Show the floating dev tools (simulate location, speed up the queue, reset data).
# Always off in production builds unless you set it explicitly.
NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# SMS is not part of the free MVP. Keep false until an SMS provider is wired in.
NEXT_PUBLIC_FEATURE_SMS=false

# Mock adapter only: treat every branch as open, whatever the clock says.
NEXT_PUBLIC_MOCK_ALWAYS_OPEN=true

# Mock adapter only: pre-fill history and one upcoming booking after first sign in.
NEXT_PUBLIC_MOCK_SEED_HISTORY=true

# Serve the staff console under /staff. Set false for a customer-only deployment.
# Build-time flag, like every NEXT_PUBLIC_ value.
NEXT_PUBLIC_ENABLE_STAFF=true
