# ─── Adapter ─────────────────────────────────────────────────────────────────
# "mock"     = fully in-browser, no backend needed (Playwright / offline dev)
# "supabase" = real Supabase backend (staging & production)
NEXT_PUBLIC_QBIT9_ADAPTER=supabase

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.qbit9.in

# ─── Feature flags ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_DEVTOOLS=false
NEXT_PUBLIC_FEATURE_SMS=false
NEXT_PUBLIC_ENABLE_STAFF=true

# Mock-only flags (ignored when adapter=supabase)
NEXT_PUBLIC_MOCK_ALWAYS_OPEN=true
NEXT_PUBLIC_MOCK_SEED_HISTORY=true

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate once:  npx web-push generate-vapid-keys
# Paste the PUBLIC key here; the PRIVATE key goes in Supabase Edge Function secrets.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>

# ─── Sentry ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=<sentry-dsn>

# ─── Server-side secrets (never exposed to the browser) ──────────────────────
# Add these in:
#   - Supabase dashboard → Project Settings → Edge Functions → Secrets
#   - Vercel → Project Settings → Environment Variables (server-only)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
STAFF_JWT_SECRET=<project-jwt-secret>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:ops@qbit9.in
RESEND_API_KEY=<resend-api-key>
MSG91_AUTH_KEY=<msg91-key>          # later, when NEXT_PUBLIC_FEATURE_SMS=true

# ─── CI only (GitHub Actions secrets) ────────────────────────────────────────
SUPABASE_ACCESS_TOKEN=<supabase-access-token>
SUPABASE_DB_PASSWORD=<db-password>
SENTRY_AUTH_TOKEN=<sentry-auth-token>
