+/**
+ * Sample staff accounts for the mock adapter. ALL OF THIS IS SAMPLE DATA.
+ * Real accounts are created by the branch admin and live in the backend (`staff`, `rosters`
+ * tables, see docs/backend-handoff.md). PINs are never stored in the clear there.
+ */
+import type { ID, StaffMember } from "@/domain";
+
+/** Every sample account uses this PIN. The sign in screen shows it in demo mode. */
+export const DEMO_PIN = "4821";
+
+export interface StaffAccount extends StaffMember {
+  /** The counter the roster assigns today. */
+  counter: number;
+  shiftStart: string;
+  shiftEnd: string;
+}
+
+const acct = (n: number, employeeId: string, name: string, branchId: ID, counter: number, shiftStart: string, shiftEnd: string): StaffAccount => ({
+  id: `stf_${n}`, employeeId, name, branchId, role: "teller", counter, shiftStart, shiftEnd,
+});
+
+export const STAFF_ACCOUNTS: StaffAccount[] = [
+  acct(1, "E48213", "Meera Joshi", "br_sbi_main_road", 4, "09:30", "13:30"),
+  acct(2, "E48214", "Arjun Patel", "br_sbi_main_road", 5, "10:00", "14:00"),
+  acct(3, "E48101", "Kavita Shah", "br_sbi_main_road", 1, "10:00", "14:00"),
+  acct(4, "E48310", "Imran Khan", "br_sbi_main_road", 3, "10:00", "16:00"),
+  acct(5, "E52007", "Neha Desai", "br_bob_navrangpura", 4, "10:00", "14:00"),
+];
+
+export const accountByEmployeeId = (employeeId: string) => STAFF_ACCOUNTS.find((a) => a.employeeId === employeeId);
+export const accountById = (id: ID) => STAFF_ACCOUNTS.find((a) => a.id === id);
diff --git a/src/services/mock/staff/floor.ts b/src/services/mock/staff/floor.ts
new file mode 100644
index 0000000..1e0edb0
--- /dev/null
+++ b/src/services/mock/staff/floor.ts
@@ -0,0 +1,245 @@
+/**
+ * The mock "branch floor": everyone staff can see at a branch today.
+ *
+ * Staff see two kinds of customer, merged into one list of `QueueEntry`:
+ *  - App tokens, from the customer mock database. Staff actions edit those rows, so the
+ *    customer's phone sees them.
+ *  - Counter entries: simulated customers (so a demo has a crowd) and walk-ins staff issue.
+ *
+ * A real backend replaces all of this with one query over the `tokens` table. Nothing here leaks
+ * into the screens: they only ever see `QueueEntry`.
+ */
+import {
+  DEFAULT_POLICY, callDeadline, entryStatus, formatTokenCode, stageOf, reconcile, tzParts,
+  type Branch, type ClosedBy, type EpochMs, type ID, type PriorityTag, type QueueEntry, type ServiceGroup, type TokenRecord,
+} from "@/domain";
+import { GROUPS, ambientWaiting, findService, hash } from "../catalogue";
+import { loadDb, mutate, uid, type MockTokenRow } from "../db";
+import { ctxFor } from "../engine";
+import { nextNumber } from "../queue";
+import { NOMINAL_STEP_MS } from "./live";
+import { loadFloor, mutateFloor, type FloorDb, type MockEntryRecord, type ShiftRow, type TokenOverlay, staffName } from "./store";
+import type { CounterOption } from "../../staff-types";
+
+/** While a service is below its target crowd, one simulated customer arrives this often. */
+export const ARRIVAL_GAP_MS = 60_000;
+
+const NAMES = ["Ramesh", "Sunita", "Kiran", "Anil", "Priya", "Mohan", "Farida", "Dev", "Lata", "Imran", "Geeta", "Vikram", "Nisha", "Harish", "Pooja", "Salim"];
+const INITIALS = "ABCDGJKMNPRSTV";
+
+export const dayKeyOf = (branch: Pick<Branch, "timezone">, ts: EpochMs) => tzParts(ts, branch.timezone).dateKey;
+
+const groupOf = (groupId: ID): ServiceGroup => GROUPS.find((g) => g.id === groupId) as ServiceGroup;
+
+export const groupIdsOf = (branch: Branch, counter: number): ID[] => branch.counters.find((c) => c.number === counter)?.groupIds ?? [];
+
+const firstNameOf = (name: string | null): string | null => (name ? (name.trim().split(/\s+/)[0] ?? null) : null);
+
+/* ------------------------------------------------------------------- simulation */
+
+function simFor(seed: string) {
+  const h = hash(seed);
+  const replyAfterMs = 6_000 + (h % 14) * 1_000;
+  return { replyAfterMs, arriveAfterMs: replyAfterMs + 8_000 + ((h >> 4) % 18) * 1_000, noReply: (h >> 8) % 8 === 0 };
+}
+
+function nameFor(seed: string): string | null {
+  const h = hash(`${seed}|name`);
+  if (h % 10 < 3) return null;
+  return `${NAMES[h % NAMES.length]} ${INITIALS[(h >> 5) % INITIALS.length]}.`;
+}
+
+function priorityFor(seed: string): PriorityTag[] {
+  const m = hash(`${seed}|prio`) % 12;
+  return m < 2 ? ["senior_citizen"] : m === 2 ? ["pensioner"] : [];
+}
+
+/** What a simulated customer has done by `now`: replied, arrived, or let the call lapse. */
+export function settleEntry(r: MockEntryRecord, now: EpochMs): MockEntryRecord {
+  if (!r.sim || r.closeKind || r.calledAt == null) return r;
+  if (r.sim.noReply) {
+    const lapseAt = r.calledAt + DEFAULT_POLICY.calledWindowMs;
+    return now > lapseAt ? { ...r, closeKind: "no_show", closedAt: lapseAt, closedBy: "auto", held: false } : r;
+  }
+  let out = r;
+  if (r.repliedAt == null && now >= r.calledAt + r.sim.replyAfterMs) out = { ...out, repliedAt: r.calledAt + r.sim.replyAfterMs };
+  if (r.arrivedAt == null && now >= r.calledAt + r.sim.arriveAfterMs) out = { ...out, arrivedAt: r.calledAt + r.sim.arriveAfterMs, repliedAt: out.repliedAt ?? r.calledAt + r.sim.replyAfterMs };
+  return out;
+}
+
+/** The size of the crowd this service should show, so demos stay busy without a second person. */
+export function targetWaiting(branch: Branch, group: ServiceGroup, now: EpochMs): number {
+  const ambient = group.services.reduce((n, s) => n + ambientWaiting(branch.id, s.id, now), 0);
+  const floor = group.id === "grp_cash" || group.id === "grp_accounts" ? 2 : 1;
+  return Math.min(6, Math.max(floor, Math.round(ambient * 0.5)));
+}
+
+function newSimEntry(branch: Branch, group: ServiceGroup, now: EpochMs, joinedAt: EpochMs): MockEntryRecord {
+  const number = mutate((db) => nextNumber(db, branch, group.id, now));
+  const seed = `${branch.id}|${group.id}|${number}`;
+  const h = hash(seed);
+  const service = group.services[h % group.services.length] as ServiceGroup["services"][number];
+  const kind = (h >> 3) % 5;
+  return {
+    id: uid("ent"), code: formatTokenCode(group.tokenPrefix, number), number, branchId: branch.id, serviceId: service.id, groupId: group.id,
+    name: nameFor(seed), phone: null, origin: kind === 0 ? "booking" : kind === 1 ? "counter" : "app", priority: priorityFor(seed),
+    joinedAt, orderAt: joinedAt, calledAt: null, counter: null, arrivedAt: null, repliedAt: null, closedAt: null, closeKind: null, closedBy: null,
+    held: false, note: null, recalls: 0, sim: simFor(seed),
+  };
+}
+
+/**
+ * Give today's floor an opening crowd the first time anyone looks, then keep it topped up at a
+ * gentle pace while staff work through it.
+ */
+export function ensureFloor(branch: Branch, now: EpochMs): void {
+  const dayStamp = `${branch.id}|${dayKeyOf(branch, now)}`;
+  mutateFloor((f) => {
+    const first = !f.seeded[dayStamp];
+    f.seeded[dayStamp] = true;
+    for (const group of GROUPS) {
+      const gk = `${dayStamp}|${group.id}`;
+      const waitingSim = Object.values(f.entries).filter((e) => e.branchId === branch.id && e.sim && e.groupId === group.id && entryStatus(settleEntry(e, now)) === "waiting").length;
+      const need = targetWaiting(branch, group, now) - waitingSim;
+      if (need <= 0) continue;
+      const due = first || now - (f.lastArrival[gk] ?? 0) >= ARRIVAL_GAP_MS;
+      if (!due) continue;
+      const add = first ? need : 1;
+      for (let i = 0; i < add; i++) {
+        const rec = newSimEntry(branch, group, now, now - (add - i) * 40_000);
+        f.entries[rec.id] = rec;
+      }
+      f.lastArrival[gk] = now;
+    }
+    // Drop anything older than two days so storage does not grow forever.
+    for (const [id, e] of Object.entries(f.entries)) if ((e.closedAt ?? e.joinedAt) < now - 2 * 86_400_000) delete f.entries[id];
+  });
+}
+
+/** Earlier visits for the Today screen, created once per counter per day. Marked as demo data in the UI. */
+export function ensureHistory(branch: Branch, counter: number, now: EpochMs): void {
+  const dk = dayKeyOf(branch, now);
+  const stamp = `${branch.id}|${dk}|hist|${counter}`;
+  mutateFloor((f) => {
+    if (f.seeded[stamp]) return;
+    f.seeded[stamp] = true;
+    const groupId = groupIdsOf(branch, counter)[0];
+    if (!groupId) return;
+    const group = groupOf(groupId);
+    const gk = `${branch.id}|${dk}|${group.id}`;
+    const base = 40 + (hash(`${branch.id}|${group.id}|${dk}`) % 25);
+    const avgMin = group.services.reduce((n, s) => n + s.avgServiceMin, 0) / group.services.length;
+    const k = 5 + (hash(stamp) % 6);
+    let ptr = f.histNext[gk] ?? base;
+    for (let i = 0; i < k; i++) {
+      if (ptr < 1) break;
+      const seed = `${stamp}|${i}`;
+      const h = hash(seed);
+      const service = group.services[h % group.services.length] as ServiceGroup["services"][number];
+      const durationMs = Math.round(service.avgServiceMin * 60_000 * (0.7 + (h % 7) / 10));
+      const closedAt = now - 3 * 60_000 - (k - 1 - i) * Math.round(avgMin * 60_000 * 1.2);
+      const rec: MockEntryRecord = {
+        id: uid("ent"), code: formatTokenCode(group.tokenPrefix, ptr), number: ptr, branchId: branch.id, serviceId: service.id, groupId: group.id,
+        name: nameFor(seed), phone: null, origin: "app", priority: priorityFor(seed), joinedAt: closedAt - durationMs - 10 * 60_000, orderAt: closedAt - durationMs - 10 * 60_000,
+        calledAt: closedAt - durationMs - 20_000, counter, arrivedAt: closedAt - durationMs, repliedAt: closedAt - durationMs - 10_000,
+        closedAt, closeKind: "served", closedBy: "staff", held: false, note: null, recalls: 0, sim: null,
+      };
+      f.entries[rec.id] = rec;
+      ptr -= 1;
+    }
+    if (hash(stamp) % 3 === 0 && ptr >= 1) {
+      const closedAt = now - 40 * 60_000;
+      const rec: MockEntryRecord = {
+        id: uid("ent"), code: formatTokenCode(group.tokenPrefix, ptr), number: ptr, branchId: branch.id, serviceId: (group.services[0] as ServiceGroup["services"][number]).id, groupId: group.id,
+        name: null, phone: null, origin: "app", priority: [], joinedAt: closedAt - 15 * 60_000, orderAt: closedAt - 15 * 60_000,
+        calledAt: closedAt - DEFAULT_POLICY.calledWindowMs, counter, arrivedAt: null, repliedAt: null,
+        closedAt, closeKind: "no_show", closedBy: "auto", held: false, note: null, recalls: 0, sim: null,
+      };
+      f.entries[rec.id] = rec;
+      ptr -= 1;
+    }
+    f.histNext[gk] = ptr;
+  });
+}
+
+/* ------------------------------------------------------------------- build entries */
+
+export function toQueueEntry(r: MockEntryRecord): QueueEntry {
+  const status = entryStatus(r);
+  const found = findService(r.serviceId);
+  return {
+    id: r.id, code: r.code, number: r.number, name: firstNameOf(r.name), serviceId: r.serviceId, serviceName: found?.service.name ?? "Service",
+    groupId: r.groupId, origin: r.origin, live: false, priority: r.priority, joinedAt: r.joinedAt, orderAt: r.orderAt, status, held: r.held && status === "serving",
+    counter: r.counter, calledAt: r.calledAt, arrivedAt: r.arrivedAt, replied: r.repliedAt != null || r.arrivedAt != null,
+    callDeadline: status === "called" && r.calledAt != null ? r.calledAt + DEFAULT_POLICY.calledWindowMs : null,
+    confirming: false, note: r.note, recalls: r.recalls, closedAt: r.closedAt, closedBy: r.closedBy, avgServiceMin: found?.service.avgServiceMin ?? 6,
+  };
+}
+
+function fromTokenRow(row: MockTokenRow, rec: TokenRecord, now: EpochMs, name: string | null, overlay: TokenOverlay | undefined): QueueEntry | null {
+  const ctx = ctxFor(row);
+  const stage = stageOf(rec, ctx, now);
+  if (stage === "left") return null;
+  const found = findService(row.serviceId);
+  const status = stage === "checkin" ? "waiting" : stage === "missed" ? "no_show" : stage === "waiting" ? "waiting" : stage;
+  const closedAt = rec.servedAt ?? rec.missedAt;
+  const closedBy: ClosedBy | null = closedAt == null ? null : (overlay?.closedBy ?? (stage === "missed" ? "auto" : "staff"));
+  return {
+    id: rec.id, code: rec.code, number: rec.number, name: firstNameOf(name), serviceId: rec.serviceId, serviceName: found?.service.name ?? "Service",
+    groupId: rec.groupId, origin: rec.source === "booking" ? "booking" : "app", live: true, priority: rec.priority, joinedAt: rec.joinedAt,
+    orderAt: rec.joinedAt + rec.delayPositions * NOMINAL_STEP_MS, status, held: !!overlay?.held && stage === "serving",
+    counter: stage === "waiting" || stage === "checkin" ? null : rec.counter, calledAt: rec.calledAt, arrivedAt: rec.servingStartedAt,
+    replied: rec.onMyWayAt != null || rec.servingStartedAt != null, callDeadline: stage === "called" ? callDeadline(rec, ctx.policy) : null,
+    confirming: stage === "checkin", note: overlay?.note ?? null, recalls: overlay?.recalls ?? 0, closedAt, closedBy, avgServiceMin: found?.service.avgServiceMin ?? 6,
+  };
+}
+
+/** Everyone staff can see at the branch today, merged and not yet sorted. */
+export function buildEntries(branch: Branch, now: EpochMs): QueueEntry[] {
+  const today = dayKeyOf(branch, now);
+  const f = loadFloor();
+  const out: QueueEntry[] = [];
+
+  for (const rec of Object.values(f.entries)) {
+    if (rec.branchId !== branch.id) continue;
+    const settled = settleEntry(rec, now);
+    if (dayKeyOf(branch, settled.closedAt ?? settled.joinedAt) !== today) continue;
+    out.push(toQueueEntry(settled));
+  }
+
+  const db = loadDb();
+  for (const row of Object.values(db.tokens)) {
+    if (row.branchId !== branch.id) continue;
+    const terminal = row.servedAt != null || row.missedAt != null || row.leftAt != null;
+    const rec = terminal ? row : reconcile(row, ctxFor(row), now).record;
+    const stamp = rec.servedAt ?? rec.missedAt ?? rec.joinedAt;
+    if (dayKeyOf(branch, stamp) !== today) continue;
+    const entry = fromTokenRow(row, rec, now, db.users[row.userId]?.name ?? null, f.overlays[row.id]);
+    if (entry) out.push(entry);
+  }
+  return out;
+}
+
+/* ----------------------------------------------------------------------- counters */
+
+export function shiftToday(f: FloorDb, staffId: ID, dateKey: string): ShiftRow | null {
+  const s = f.shifts[staffId];
+  return s && s.dateKey === dateKey ? s : null;
+}
+
+export function counterOptions(branch: Branch, f: FloorDb, dateKey: string): CounterOption[] {
+  return branch.counters.map((c) => {
+    const holder = Object.entries(f.shifts).find(
+      ([, s]) => s.branchId === branch.id && s.dateKey === dateKey && s.counter === c.number && (s.status === "open" || s.status === "break"),
+    );
+    const groupNames = c.groupIds.flatMap((gid) => groupOf(gid).services.map((s) => s.name));
+    return {
+      number: c.number,
+      groupIds: c.groupIds,
+      serviceNames: groupNames,
+      takenBy: holder ? staffName(holder[0]) : null,
+      onBreak: holder?.[1].status === "break",
+    };
+  });
+}
+
diff --git a/src/services/mock/staff/live.ts b/src/services/mock/staff/live.ts
new file mode 100644
index 0000000..42f1985
--- /dev/null
+++ b/src/services/mock/staff/live.ts
@@ -0,0 +1,92 @@
+/**
+ * The real queue, for the mock.
+ *
+ * While a staff counter is open at a branch, customers' places come from the same list staff work
+ * through: the line moves when staff call people, not on a timer. This builds that view from the two
+ * mock stores without reconciling anything (reconcile asks this module for "ahead", so it must not
+ * call back into it).
+ *
+ * With nobody on a counter the customer app falls back to its own simulation, so it still works
+ * alone. A real backend always has this: it is one query over the tokens table.
+ */
+import { compareQueueOrder, tzParts, type Branch, type EpochMs, type ID, type LiveQueue, type TokenRecord } from "@/domain";
+import { readRaw } from "@/lib/storage";
+import { DB_KEY, loadDb } from "../db";
+import { FLOOR_KEY, loadFloor } from "./store";
+
+/** How much one position of setback is worth when ordering tokens against counter entries. */
+export const NOMINAL_STEP_MS = 90_000;
+/** A token staff called must never be auto-finished by the customer simulation. */
+export const STAFF_SERVICE_MS = 12 * 3_600_000;
+
+interface Item {
+  id: ID;
+  code: string;
+  groupId: ID;
+  serviceId: ID;
+  number: number;
+  hasPriority: boolean;
+  orderAt: EpochMs;
+  calledAt: EpochMs | null;
+  waiting: boolean;
+}
+
+interface Snapshot {
+  staffed: boolean;
+  items: Item[];
+}
+
+let cache: { key: string; value: Snapshot } | null = null;
+
+function snapshot(branch: Pick<Branch, "id" | "timezone">, now: EpochMs): Snapshot {
+  const today = tzParts(now, branch.timezone).dateKey;
+  const key = `${branch.id}|${today}|${readRaw(DB_KEY)}|${readRaw(FLOOR_KEY)}`;
+  if (cache?.key === key) return cache.value;
+
+  const f = loadFloor();
+  const staffed = Object.values(f.shifts).some((s) => s.branchId === branch.id && s.dateKey === today && (s.status === "open" || s.status === "break"));
+  const items: Item[] = [];
+  if (staffed) {
+    const dayOf = (ts: EpochMs) => tzParts(ts, branch.timezone).dateKey;
+    for (const e of Object.values(f.entries)) {
+      if (e.branchId !== branch.id || dayOf(e.joinedAt) !== today || e.closeKind) continue;
+      items.push({
+        id: e.id, code: e.code, groupId: e.groupId, serviceId: e.serviceId, number: e.number, hasPriority: e.priority.length > 0,
+        orderAt: e.orderAt, calledAt: e.calledAt, waiting: e.calledAt == null,
+      });
+    }
+    for (const t of Object.values(loadDb().tokens)) {
+      if (t.branchId !== branch.id || t.leftAt != null || t.servedAt != null || t.missedAt != null || dayOf(t.joinedAt) !== today) continue;
+      items.push({
+        id: t.id, code: t.code, groupId: t.groupId, serviceId: t.serviceId, number: t.number, hasPriority: t.priority.length > 0,
+        orderAt: t.joinedAt + t.delayPositions * NOMINAL_STEP_MS, calledAt: t.calledAt, waiting: t.calledAt == null,
+      });
+    }
+  }
+  const value = { staffed, items };
+  cache = { key, value };
+  return value;
+}
+
+/** People waiting in a service group's queue, or null when the branch is not staffed. */
+export function waitingInGroup(branch: Pick<Branch, "id" | "timezone">, groupId: ID, now: EpochMs): number | null {
+  const s = snapshot(branch, now);
+  return s.staffed ? s.items.filter((i) => i.waiting && i.groupId === groupId).length : null;
+}
+
+/** The queue as the customer app should see it, or undefined when it should simulate its own. */
+export function liveQueueFor(branch: Pick<Branch, "id" | "timezone">, now: EpochMs): LiveQueue | undefined {
+  if (!snapshot(branch, now).staffed) return undefined;
+  const view = () => snapshot(branch, now).items;
+  return {
+    ahead: (r: TokenRecord) => {
+      const me = { hasPriority: r.priority.length > 0, orderAt: r.joinedAt + r.delayPositions * NOMINAL_STEP_MS, number: r.number };
+      return view().filter((i) => i.waiting && i.groupId === r.groupId && i.id !== r.id && compareQueueOrder(i, me) < 0).length;
+    },
+    nowServing: (r: TokenRecord) => {
+      let best: Item | null = null;
+      for (const i of view()) if (i.groupId === r.groupId && i.calledAt != null && (!best || (i.calledAt > (best.calledAt as number)))) best = i;
+      return best?.code ?? null;
+    },
+  };
+}
diff --git a/src/services/mock/staff/service.ts b/src/services/mock/staff/service.ts
new file mode 100644
index 0000000..d5a88f3
--- /dev/null
+++ b/src/services/mock/staff/service.ts
@@ -0,0 +1,548 @@
+import {
+  DomainError, STAFF_POLICY, aheadForNewToken, breakImpactMin, callEntry, callToken, closeEntry, currentAt, estimateWait, finishServing,
+  heldAt, holdEntry, isCallable, markTokenNoShow, pickNext, pinLockRemainingMs, recallEntry, recallToken, registerWrongPin, reopenEntry, reopenToken,
+  resumeEntry, shouldNudge, snoozeUntil, sortEntries, startServing, summarizeDay, transferEntry, transferToken, validateEmployeeId,
+  validateName, validateNote, validatePhone, validatePin, validatePrioritySafe, withNote, formatTokenCode, IDLE_SHIFT,
+  type BreakReason, type Branch, type EpochMs, type ID, type QueueEntry, type StaffSession,
+} from "@/domain";
+import { STAFF_SERVICE_MS } from "./live";
+import { clock } from "@/lib/clock";
+import { GROUPS, findService, getBranches } from "../catalogue";
+import { loadDb, mutate, onDbChange, uid, type MockTokenRow } from "../db";
+import { ctxFor } from "../engine";
+import { nextNumber } from "../queue";
+import type {
+  BreakInfo, CallOptions, CounterOption, CounterState, QueueScope, QueueState, Roster, StaffBranch, StaffDevApi, StaffService, TodayState, WalkInResult,
+} from "../../staff-types";
+import { DEMO_PIN, accountByEmployeeId, accountById, type StaffAccount } from "./accounts";
+import {
+  buildEntries, counterOptions, dayKeyOf, ensureFloor, ensureHistory, groupIdsOf, settleEntry, shiftToday, toQueueEntry,
+} from "./floor";
+import { counterNumbersOnBreak, loadFloor, mutateFloor, onFloorChange, resetFloor, type MockEntryRecord, type ShiftRow } from "./store";
+
+/* ----------------------------------------------------------------------- context */
+
+interface Ctx {
+  now: EpochMs;
+  account: StaffAccount;
+  branch: Branch;
+  dateKey: string;
+  shift: ShiftRow | null;
+}
+
+function ctxNow(): Ctx {
+  const now = clock.now();
+  const f = loadFloor();
+  const s = f.session;
+  if (!s || s.expiresAt <= now) throw new DomainError("not_signed_in");
+  const account = accountById(s.staffId);
+  const branch = getBranches(now).find((b) => b.id === account?.branchId);
+  if (!account || !branch) throw new DomainError("not_signed_in");
+  const dateKey = dayKeyOf(branch, now);
+  return { now, account, branch, dateKey, shift: shiftToday(f, account.id, dateKey) };
+}
+
+/** Context for actions that need an open shift (not idle, ended or on a break). */
+function ctxOpen(): Ctx & { shift: ShiftRow; counter: number } {
+  const c = ctxNow();
+  if (!c.shift || c.shift.status === "idle" || c.shift.status === "ended" || c.shift.counter == null) throw new DomainError("shift_not_started");
+  if (c.shift.status === "break") throw new DomainError("shift_on_break");
+  return { ...c, shift: c.shift, counter: c.shift.counter };
+}
+
+const staffBranch = (b: Branch): StaffBranch => ({ id: b.id, name: b.name, bankName: b.bank.name, bankShort: b.bank.shortName, timezone: b.timezone });
+
+const writeShift = (c: Ctx, patch: Partial<ShiftRow>) =>
+  mutateFloor((f) => {
+    const base: ShiftRow = c.shift ?? { ...IDLE_SHIFT, dateKey: c.dateKey, branchId: c.branch.id };
+    f.shifts[c.account.id] = { ...base, ...patch, dateKey: c.dateKey, branchId: c.branch.id };
+  });
+
+/* ----------------------------------------------------------------- finding people */
+
+type Target = { kind: "live"; row: MockTokenRow } | { kind: "entry"; rec: MockEntryRecord };
+
+function findTarget(id: ID, now: EpochMs): Target | null {
+  const row = loadDb().tokens[id];
+  if (row) return { kind: "live", row };
+  const rec = loadFloor().entries[id];
+  return rec ? { kind: "entry", rec: settleEntry(rec, now) } : null;
+}
+
+const saveRow = (row: MockTokenRow, patch: Partial<MockTokenRow>) =>
+  mutate((db) => {
+    db.tokens[row.id] = { ...row, ...patch };
+  });
+
+const saveEntry = (rec: MockEntryRecord) =>
+  mutateFloor((f) => {
+    f.entries[rec.id] = rec;
+  });
+
+const patchOverlay = (id: ID, fn: (o: { note: string | null; held: boolean; recalls: number; closedBy: "staff" | "auto" | null }) => void) =>
+  mutateFloor((f) => {
+    const o = f.overlays[id] ?? { note: null, held: false, recalls: 0, closedBy: null };
+    fn(o);
+    f.overlays[id] = o;
+  });
+
+const need = (id: ID, now: EpochMs): Target => {
+  const t = findTarget(id, now);
+  if (!t) throw new DomainError("entry_not_found");
+  return t;
+};
+
+/* -------------------------------------------------------------------- the actions */
+
+function callTarget(id: ID, counter: number, now: EpochMs) {
+  const t = need(id, now);
+  if (t.kind === "live") {
+    const { record } = callToken(t.row, ctxFor(t.row), now, counter);
+    // Staff decide when the visit ends, so the customer simulation must not auto-finish it.
+    saveRow(t.row, { ...record, serviceMs: STAFF_SERVICE_MS });
+    patchOverlay(id, (o) => { o.closedBy = null; o.held = false; o.recalls = 0; });
+  } else {
+    saveEntry(callEntry(t.rec, now, counter));
+  }
+}
+
+function closeTarget(id: ID, as: "served" | "no_show", now: EpochMs) {
+  const t = need(id, now);
+  if (t.kind === "live") {
+    const ctx = ctxFor(t.row);
+    const { record } = as === "served" ? finishServing(t.row, ctx, now) : markTokenNoShow(t.row, ctx, now);
+    saveRow(t.row, record);
+    patchOverlay(id, (o) => { o.closedBy = "staff"; o.held = false; });
+  } else {
+    saveEntry(closeEntry(t.rec, as, now, "staff"));
+  }
+}
+
+/** Close whoever is at the counter. Someone who has not arrived must be closed as a no-show on purpose. */
+function closeCurrent(cur: QueueEntry, closeAs: "served" | "no_show" | undefined, now: EpochMs) {
+  if (cur.status === "serving") return closeTarget(cur.id, "served", now);
+  if (!closeAs) throw new DomainError("current_not_arrived");
+  if (closeAs !== "no_show") throw new DomainError("invalid_state", "Only a customer who has arrived can be marked as served");
+  closeTarget(cur.id, "no_show", now);
+}
+
+/* -------------------------------------------------------------------- state views */
+
+function openCountersOf(branch: Branch, groupId: ID): { total: number; open: number } {
+  const total = branch.counters.filter((c) => c.groupIds.includes(groupId)).map((c) => c.number);
+  const away = counterNumbersOnBreak(branch.id);
+  return { total: total.length, open: total.filter((n) => !away.includes(n)).length };
+}
+
+function counterOption(branch: Branch, f: ReturnType<typeof loadFloor>, dateKey: string, n: number): CounterOption {
+  const opt = counterOptions(branch, f, dateKey).find((c) => c.number === n);
+  if (!opt) throw new DomainError("counter_not_found");
+  return opt;
+}
+
+function counterState(c: Ctx): CounterState {
+  const { now, account, branch } = c;
+  if (!c.shift || c.shift.counter == null || c.shift.status === "idle" || c.shift.status === "ended") throw new DomainError("shift_not_started");
+  ensureFloor(branch, now);
+  const f = loadFloor();
+  const counter = c.shift.counter;
+  const mine = groupIdsOf(branch, counter);
+  const entries = buildEntries(branch, now);
+  const current = currentAt(entries, counter);
+  const waitingMine = entries.filter((e) => e.status === "waiting" && mine.includes(e.groupId));
+  const closedMine = entries.filter((e) => e.counter === counter && (e.status === "served" || e.status === "no_show"));
+  const summary = summarizeDay(closedMine, now, branch.timezone);
+  const options = counterOptions(branch, f, c.dateKey);
+
+  let onBreak: BreakInfo | null = null;
+  if (c.shift.status === "break" && c.shift.breakReason && c.shift.breakStartedAt != null) {
+    const gid = mine[0];
+    const services = gid ? (GROUPS.find((g) => g.id === gid)?.services ?? []) : [];
+    const avg = services.length ? services.reduce((n, s) => n + s.avgServiceMin, 0) / services.length : 6;
+    const { total, open } = gid ? openCountersOf(branch, gid) : { total: 1, open: 1 };
+    const waiting = gid ? entries.filter((e) => e.status === "waiting" && e.groupId === gid).length : 0;
+    onBreak = { reason: c.shift.breakReason, startedAt: c.shift.breakStartedAt, impactMin: breakImpactMin(waiting, avg, total, open) };
+  }
+
+  const transferTargets = current
+    ? options
+        .filter((o) => o.number !== counter && o.groupIds.includes(current.groupId) && o.takenBy != null && !o.onBreak)
+        .map((o) => ({ ...o, busy: currentAt(entries, o.number) != null }))
+    : [];
+
+  return {
+    staff: account, branch: staffBranch(branch), counter: counterOption(branch, f, c.dateKey, counter), shift: c.shift, now,
+    waitingMine: waitingMine.length, served: summary.served, avgServiceMs: summary.avgServiceMs, current, held: heldAt(entries, counter),
+    next: sortEntries(waitingMine).slice(0, 4), nextCallable: pickNext(entries, mine),
+    nudge: shouldNudge(current, now, c.shift.nudgeSnoozedUntil), onBreak, transferTargets,
+  };
+}
+
+const fresh = (): CounterState => counterState(ctxNow());
+
+function rosterOf(c: Ctx): Roster {
+  const { now, account, branch } = c;
+  ensureFloor(branch, now);
+  const f = loadFloor();
+  const options = counterOptions(branch, f, c.dateKey);
+  const shift: ShiftRow = c.shift ?? { ...IDLE_SHIFT, dateKey: c.dateKey, branchId: branch.id };
+  const waiting = buildEntries(branch, now).filter((e) => e.status === "waiting").length;
+  const last = shift.status === "ended" ? (f.lastShift[account.id] ?? null) : null;
+  return {
+    staff: account, branch: staffBranch(branch), dateKey: c.dateKey, assigned: counterOption(branch, f, c.dateKey, account.counter),
+    shiftStart: account.shiftStart, shiftEnd: account.shiftEnd, shift, counters: options,
+    countersOpen: options.filter((o) => o.takenBy != null && !o.onBreak).length, countersTotal: options.length, waiting, lastShift: last,
+  };
+}
+
+/* ------------------------------------------------------------------------ service */
+
+export function createStaffService(): StaffService {
+  return {
+    capabilities: () => ({ passkey: false }),
+
+    async getSession(): Promise<StaffSession | null> {
+      try {
+        const c = ctxNow();
+        const s = loadFloor().session;
+        return { staff: c.account, expiresAt: (s as NonNullable<typeof s>).expiresAt };
+      } catch {
+        return null;
+      }
+    },
+
+    async signIn({ employeeId, pin }) {
+      const now = clock.now();
+      const id = validateEmployeeId(employeeId);
+      if (!id.ok) throw new DomainError("invalid_credentials", id.error);
+      const p = validatePin(pin);
+      if (!p.ok) throw new DomainError("invalid_credentials", p.error);
+      return mutateFloor((f) => {
+        const lock = pinLockRemainingMs(f.attempts[id.value], now);
+        if (lock > 0) throw new DomainError("account_locked", undefined, { retryAfterMs: lock });
+        const account = accountByEmployeeId(id.value);
+        if (!account || pin !== DEMO_PIN) {
+          f.attempts[id.value] = registerWrongPin(f.attempts[id.value], now);
+          const after = pinLockRemainingMs(f.attempts[id.value], now);
+          if (after > 0) throw new DomainError("account_locked", undefined, { retryAfterMs: after });
+          throw new DomainError("invalid_credentials");
+        }
+        delete f.attempts[id.value];
+        const expiresAt = now + STAFF_POLICY.sessionMs;
+        f.session = { staffId: account.id, expiresAt };
+        return { staff: account, expiresAt };
+      });
+    },
+
+    async signOut() {
+      mutateFloor((f) => {
+        f.session = null;
+      });
+    },
+
+    async roster() {
+      return rosterOf(ctxNow());
+    },
+
+    async startShift(counter) {
+      const c = ctxNow();
+      const target = counter ?? c.account.counter;
+      const f = loadFloor();
+      const opt = counterOptions(c.branch, f, c.dateKey).find((o) => o.number === target);
+      if (!opt) throw new DomainError("counter_not_found");
+      if (opt.takenBy && opt.takenBy !== c.account.name) throw new DomainError("counter_taken");
+      const already = c.shift && (c.shift.status === "open" || c.shift.status === "break") && c.shift.counter === target;
+      ensureFloor(c.branch, c.now);
+      ensureHistory(c.branch, target, c.now);
+      if (!already) {
+        writeShift(c, {
+          status: "open", counter: target, startedAt: c.now, endedAt: null, breakReason: null, breakStartedAt: null, callNextPresses: 0, nudgeSnoozedUntil: null,
+        });
+      }
+      return fresh();
+    },
+
+    async startBreak(reason: BreakReason) {
+      const c = ctxNow();
+      if (!c.shift || c.shift.counter == null || (c.shift.status !== "open" && c.shift.status !== "break")) throw new DomainError("shift_not_started");
+      // Picking another reason while already away just relabels the break.
+      if (c.shift.status === "break") {
+        writeShift(c, { breakReason: reason });
+        return fresh();
+      }
+      const entries = buildEntries(c.branch, c.now);
+      if (currentAt(entries, c.shift.counter) || heldAt(entries, c.shift.counter).length) throw new DomainError("finish_current_first");
+      writeShift(c, { status: "break", breakReason: reason, breakStartedAt: c.now });
+      return fresh();
+    },
+
+    async resumeFromBreak() {
+      const c = ctxNow();
+      if (!c.shift || c.shift.status !== "break") throw new DomainError("invalid_state", "Not on a break");
+      writeShift(c, { status: "open", breakReason: null, breakStartedAt: null });
+      return fresh();
+    },
+
+    async endShift() {
+      const c = ctxNow();
+      if (!c.shift || c.shift.counter == null || (c.shift.status !== "open" && c.shift.status !== "break")) throw new DomainError("shift_not_started");
+      const entries = buildEntries(c.branch, c.now);
+      const counter = c.shift.counter;
+      if (currentAt(entries, counter) || heldAt(entries, counter).length) throw new DomainError("finish_current_first");
+      const closed = entries.filter((e) => e.counter === counter && (e.status === "served" || e.status === "no_show"));
+      const summary = summarizeDay(closed, c.now, c.branch.timezone);
+      mutateFloor((f) => {
+        f.lastShift[c.account.id] = { ...summary, endedAt: c.now };
+      });
+      writeShift(c, { status: "ended", endedAt: c.now, breakReason: null, breakStartedAt: null });
+      return rosterOf(ctxNow());
+    },
+
+    async counter() {
+      return fresh();
+    },
+
+    async callNext(opts: CallOptions = {}) {
+      const c = ctxOpen();
+      ensureFloor(c.branch, c.now);
+      const entries = buildEntries(c.branch, c.now);
+      const mine = groupIdsOf(c.branch, c.counter);
+      const cur = currentAt(entries, c.counter);
+
+      let next: QueueEntry | null;
+      if (opts.entryId) {
+        next = entries.find((e) => e.id === opts.entryId) ?? null;
+        if (!next) throw new DomainError("entry_not_found");
+        if (!mine.includes(next.groupId) || !isCallable(next)) throw new DomainError("entry_not_callable");
+      } else {
+        next = pickNext(entries, mine);
+        if (!next) throw new DomainError("queue_empty");
+      }
+      if (cur && cur.status !== "serving" && !opts.closeCurrentAs) throw new DomainError("current_not_arrived");
+
+      if (cur) closeCurrent(cur, opts.closeCurrentAs, c.now);
+      callTarget(next.id, c.counter, c.now);
+      writeShift(c, { callNextPresses: c.shift.callNextPresses + 1, nudgeSnoozedUntil: null });
+      return fresh();
+    },
+
+    async finishCurrent(as) {
+      const c = ctxOpen();
+      const cur = currentAt(buildEntries(c.branch, c.now), c.counter);
+      if (!cur) throw new DomainError("invalid_state", "Nobody is at your counter");
+      closeCurrent(cur, as, c.now);
+      writeShift(c, { nudgeSnoozedUntil: null });
+      return fresh();
+    },
+
+    async recall() {
+      const c = ctxOpen();
+      const cur = currentAt(buildEntries(c.branch, c.now), c.counter);
+      if (!cur) throw new DomainError("invalid_state", "Nobody is at your counter");
+      const t = need(cur.id, c.now);
+      if (t.kind === "live") {
+        const { record } = recallToken(t.row, ctxFor(t.row), c.now, cur.recalls);
+        saveRow(t.row, record);
+        patchOverlay(cur.id, (o) => { o.recalls += 1; });
+      } else {
+        saveEntry(recallEntry(t.rec, c.now));
+      }
+      return fresh();
+    },
+
+    async transfer(toCounter) {
+      const c = ctxOpen();
+      const state = counterState(c);
+      const cur = state.current;
+      if (!cur) throw new DomainError("invalid_state", "Nobody is at your counter");
+      if (!state.transferTargets.length) throw new DomainError("no_other_counter");
+      const target = state.transferTargets.find((o) => o.number === toCounter);
+      if (!target) throw new DomainError("counter_not_found");
+      if (target.busy) throw new DomainError("counter_busy");
+      const t = need(cur.id, c.now);
+      if (t.kind === "live") {
+        const { record } = transferToken(t.row, ctxFor(t.row), c.now, toCounter);
+        saveRow(t.row, { ...record, serviceMs: STAFF_SERVICE_MS });
+        patchOverlay(cur.id, (o) => { o.held = false; o.recalls = 0; });
+      } else {
+        saveEntry(transferEntry(t.rec, c.now, toCounter));
+      }
+      return fresh();
+    },
+
+    async hold() {
+      const c = ctxOpen();
+      const cur = currentAt(buildEntries(c.branch, c.now), c.counter);
+      if (!cur) throw new DomainError("invalid_state", "Nobody is at your counter");
+      if (cur.status !== "serving") throw new DomainError("invalid_state", "Hold is for a customer who is at your counter");
+      const t = need(cur.id, c.now);
+      if (t.kind === "live") patchOverlay(cur.id, (o) => { o.held = true; });
+      else saveEntry(holdEntry(t.rec));
+      return fresh();
+    },
+
+    async resume(entryId) {
+      const c = ctxOpen();
+      const entries = buildEntries(c.branch, c.now);
+      if (currentAt(entries, c.counter)) throw new DomainError("counter_busy");
+      const held = heldAt(entries, c.counter).find((e) => e.id === entryId);
+      if (!held) throw new DomainError("entry_not_found");
+      const t = need(entryId, c.now);
+      if (t.kind === "live") patchOverlay(entryId, (o) => { o.held = false; });
+      else saveEntry(resumeEntry(t.rec));
+      return fresh();
+    },
+
+    async setNote(note) {
+      const c = ctxOpen();
+      const n = validateNote(note);
+      if (!n.ok) throw new DomainError("invalid_note", n.error);
+      const cur = currentAt(buildEntries(c.branch, c.now), c.counter);
+      if (!cur) throw new DomainError("invalid_state", "Nobody is at your counter");
+      const t = need(cur.id, c.now);
+      if (t.kind === "live") patchOverlay(cur.id, (o) => { o.note = n.value; });
+      else saveEntry(withNote(t.rec, n.value));
+      return fresh();
+    },
+
+    async snoozeNudge() {
+      const c = ctxOpen();
+      const cur = currentAt(buildEntries(c.branch, c.now), c.counter);
+      if (cur) writeShift(c, { nudgeSnoozedUntil: snoozeUntil(c.now, cur.avgServiceMin) });
+      return fresh();
+    },
+
+    async queue(scope: QueueScope): Promise<QueueState> {
+      const c = ctxNow();
+      ensureFloor(c.branch, c.now);
+      const counter = c.shift?.counter ?? c.account.counter;
+      const mine = groupIdsOf(c.branch, counter);
+      const entries = buildEntries(c.branch, c.now);
+      const waitingAll = entries.filter((e) => e.status === "waiting");
+      const waitingMine = waitingAll.filter((e) => mine.includes(e.groupId));
+      const shown = scope === "mine" ? waitingMine : waitingAll;
+      const oldest = shown.length ? Math.min(...shown.map((e) => e.joinedAt)) : null;
+      return {
+        scope, now: c.now, groupIds: scope === "mine" ? mine : GROUPS.map((g) => g.id), counter, waiting: sortEntries(shown),
+        atCounters: entries.filter((e) => e.status === "called" || e.status === "serving").sort((a, b) => (a.counter ?? 0) - (b.counter ?? 0)),
+        mineCount: waitingMine.length, allCount: waitingAll.length,
+        longestWaitMin: oldest == null ? null : Math.max(0, Math.round((c.now - oldest) / 60_000)),
+        myGroupIds: mine, hasCurrent: !!c.shift?.counter && !!currentAt(entries, c.shift.counter),
+      };
+    },
+
+    async walkInServices() {
+      const c = ctxNow();
+      return GROUPS.filter((g) => c.branch.counters.some((k) => k.groupIds.includes(g.id))).map((g) => ({
+        groupId: g.id, groupName: g.name, services: g.services.map((s) => ({ id: s.id, name: s.name })),
+      }));
+    },
+
+    async issueWalkIn(input): Promise<WalkInResult> {
+      const c = ctxNow();
+      const name = validateName(input.name);
+      if (!name.ok) throw new DomainError("invalid_name", name.error);
+      let phone: string | null = null;
+      if (input.phone.trim()) {
+        const p = validatePhone(input.phone);
+        if (!p.ok) throw new DomainError("invalid_phone", p.error);
+        phone = p.value;
+      }
+      const found = findService(input.serviceId);
+      if (!found || !c.branch.counters.some((k) => k.groupIds.includes(found.group.id))) throw new DomainError("service_not_found");
+      const priority = validatePrioritySafe(input.priority);
+
+      ensureFloor(c.branch, c.now);
+      const waiting = buildEntries(c.branch, c.now).filter((e) => e.status === "waiting" && e.groupId === found.group.id).length;
+      const ahead = aheadForNewToken(waiting, { priority, source: "walk_in" });
+      const { open } = openCountersOf(c.branch, found.group.id);
+      const number = mutate((db) => nextNumber(db, c.branch, found.group.id, c.now));
+      const rec: MockEntryRecord = {
+        id: uid("ent"), code: formatTokenCode(found.group.tokenPrefix, number), number, branchId: c.branch.id, serviceId: found.service.id, groupId: found.group.id,
+        name: name.value, phone, origin: "counter", priority, joinedAt: c.now, orderAt: c.now, calledAt: null, counter: null, arrivedAt: null, repliedAt: null,
+        closedAt: null, closeKind: null, closedBy: null, held: false, note: null, recalls: 0,
+        // A walk-in is in the waiting area, so they walk up promptly when called.
+        sim: { replyAfterMs: 0, arriveAfterMs: 12_000, noReply: false },
+      };
+      saveEntry(rec);
+      return { entry: toQueueEntry(rec), ahead, estWait: estimateWait(ahead, found.service.avgServiceMin, Math.max(1, open)) };
+    },
+
+    async today(): Promise<TodayState> {
+      const c = ctxNow();
+      ensureFloor(c.branch, c.now);
+      const shift: ShiftRow = c.shift ?? { ...IDLE_SHIFT, dateKey: c.dateKey, branchId: c.branch.id };
+      const counter = shift.counter;
+      const entries = buildEntries(c.branch, c.now);
+      const mine = counter != null ? groupIdsOf(c.branch, counter) : [];
+      const closed = counter == null ? [] : entries.filter((e) => e.counter === counter && (e.status === "served" || e.status === "no_show"));
+      return {
+        staff: c.account, branch: staffBranch(c.branch), counter, shift, now: c.now, summary: summarizeDay(closed, c.now, c.branch.timezone),
+        autoClosed: closed.filter((e) => e.status === "no_show" && e.closedBy === "auto").sort((a, b) => (b.closedAt ?? 0) - (a.closedAt ?? 0)),
+        hasCurrent: counter != null && !!currentAt(entries, counter),
+        waitingMine: entries.filter((e) => e.status === "waiting" && mine.includes(e.groupId)).length,
+      };
+    },
+
+    async undoClosure(entryId) {
+      const c = ctxOpen();
+      const entries = buildEntries(c.branch, c.now);
+      if (currentAt(entries, c.counter)) throw new DomainError("counter_busy");
+      const e = entries.find((x) => x.id === entryId && x.counter === c.counter);
+      if (!e || e.status !== "no_show" || e.closedBy !== "auto") throw new DomainError("entry_not_found");
+      const t = need(entryId, c.now);
+      if (t.kind === "live") {
+        saveRow(t.row, { ...reopenToken(t.row, c.now, c.counter), serviceMs: STAFF_SERVICE_MS });
+        patchOverlay(entryId, (o) => { o.closedBy = null; });
+      } else {
+        saveEntry(reopenEntry(t.rec, c.now, c.counter));
+      }
+      return this.today();
+    },
+
+    subscribe(onChange) {
+      const offs = [onFloorChange(onChange), onDbChange(onChange)];
+      return () => offs.forEach((off) => off());
+    },
+  };
+}
+
+/* ---------------------------------------------------------------------- dev tools */
+
+export function createStaffDevApi(): StaffDevApi {
+  return {
+    async addCustomers(count) {
+      const c = ctxNow();
+      const counter = c.shift?.counter ?? c.account.counter;
+      const mine = groupIdsOf(c.branch, counter);
+      for (let i = 0; i < count; i++) {
+        const gid = mine[i % Math.max(1, mine.length)];
+        const group = GROUPS.find((g) => g.id === gid);
+        if (!group) continue;
+        const number = mutate((db) => nextNumber(db, c.branch, group.id, c.now));
+        const seed = `${c.now}|${number}`;
+        const h = [...seed].reduce((a, ch) => (a * 31 + ch.charCodeAt(0)) >>> 0, 7);
+        const service = group.services[h % group.services.length] as (typeof group.services)[number];
+        saveEntry({
+          id: uid("ent"), code: formatTokenCode(group.tokenPrefix, number), number, branchId: c.branch.id, serviceId: service.id, groupId: group.id,
+          name: ["Asha", "Dev", "Lata", "Rohan", "Zoya"][h % 5] ?? null, phone: null, origin: "app", priority: [], joinedAt: c.now, orderAt: c.now,
+          calledAt: null, counter: null, arrivedAt: null, repliedAt: null, closedAt: null, closeKind: null, closedBy: null, held: false, note: null, recalls: 0,
+          sim: { replyAfterMs: 6_000, arriveAfterMs: 14_000, noReply: false },
+        });
+      }
+    },
+
+    async arriveNow() {
+      const c = ctxOpen();
+      const cur = currentAt(buildEntries(c.branch, c.now), c.counter);
+      if (!cur || cur.status !== "called") return;
+      const t = need(cur.id, c.now);
+      if (t.kind === "live") saveRow(t.row, startServing(t.row, ctxFor(t.row), c.now).record);
+      else saveEntry({ ...t.rec, arrivedAt: c.now, repliedAt: t.rec.repliedAt ?? c.now });
+    },
+
+    async resetFloor() {
+      resetFloor();
+    },
+  };
+}
